{
  "name": "CS 2420 C++ Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "containerEnv": {
    "CC": "gcc-13",
    "CXX": "g++-13"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake"
      ],
      "settings": {
        "cmake.configureOnOpen": true
      }
    }
  }
}
